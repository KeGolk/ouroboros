# ─── Supabase Configuration ────────────────────────────────────────────────
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
# Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── OAuth Provider Configuration ──────────────────────────────────────────
# These are configured in the Supabase Dashboard under Authentication > Providers.
# The values below are NOT used directly by Next.js — they're set in the Supabase
# dashboard. This section documents what's needed.
#
# Google OAuth:
#   1. Create credentials at https://console.cloud.google.com/apis/credentials
#   2. Set authorized redirect URI to: https://your-project-ref.supabase.co/auth/v1/callback
#   3. Enter Client ID and Client Secret in Supabase Dashboard > Auth > Providers > Google
#
# Discord OAuth:
#   1. Create app at https://discord.com/developers/applications
#   2. Set redirect URI to: https://your-project-ref.supabase.co/auth/v1/callback
#   3. Enter Client ID and Client Secret in Supabase Dashboard > Auth > Providers > Discord

# ─── App Configuration ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
